# Plantilla de configuración. Copiar a `.env` (gitignored) y ajustar.
#
#   cp .env.example .env

# --- Base de datos del data warehouse ---
# OJO: el puerto es 5433, no 5432. El 5432 lo ocupa el Postgres de la app
# principal (../SmartCart/docker-compose.yml) y este servicio es independiente.
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics_pass
POSTGRES_DB=smartcart_analytics
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# En producción, en lugar de las POSTGRES_* de arriba: la connection string de
# Neon completa (le gana a las otras si está seteada).
# DATABASE_URL=postgresql://usuario:clave@ep-xxx.us-east-1.aws.neon.tech/smartcart_analytics?sslmode=require

# Conexiones que el pool mantiene abiertas. En producción contra Neon: 0.
# POOL_MIN_SIZE=1

# --- API de ingesta ---
# Secreto compartido con SmartCart, que lo manda en el header X-API-Key.
# En producción, generar uno nuevo: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYTICS_API_KEY=dev-local-key-change-me

# Etiqueta que se guarda en cada fila (fact_optimization.source_env) para poder
# separar los eventos de desarrollo de los reales en Power BI.
ENVIRONMENT=dev
